<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Text2SQL evaluation</title>
<style>body{font:16px system-ui;max-width:1000px;margin:40px auto;padding:0 20px;color:#172333}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f0f3f5;padding:16px}td,th{text-align:left;padding:8px;border-bottom:1px solid #ccc}table{width:100%;border-collapse:collapse}details{border-top:1px solid #ccc;padding:16px 0}summary{cursor:pointer}small{overflow-wrap:anywhere}</style>
<h1>Text2SQL evaluation</h1><p><strong>{{ 'Complete' if summary.complete else 'Incomplete' }}</strong> · {{ summary.judged }}/{{ summary.expected }} judged · Coverage {{ '%.1f'|format(summary.coverage * 100) }}%</p>
<p>Pass rate: {{ '%.1f%%'|format(summary.pass_rate * 100) if summary.pass_rate is not none else 'Not available' }} (denominator: {{ summary.pass_rate_denominator }} correct + incorrect judgments; uncertain excluded).</p>
<small>Experiment {{ summary.experiment_id }}<br>Dataset version {{ summary.dataset_version_id }}<br>Configuration {{ summary.evaluation_config_id }}<br>Application {{ summary.app_revision }}</small>
<table><tr><th>Status</th><th>Count</th></tr>{% for status, count in summary.counts.items() %}<tr><td>{{ status }}</td><td>{{ count }}</td></tr>{% endfor %}</table>
{% if summary.comparison %}<h2>Baseline comparison</h2>{% if not summary.comparison.compatible %}<p>Incompatible: {{ summary.comparison.reason }}</p>{% else %}<table><tr><th>Example</th><th>Baseline</th><th>Candidate</th><th>Change</th></tr>{% for row in summary.comparison.examples %}<tr><td>{{ row.example_id }}</td><td>{{ row.baseline }}</td><td>{{ row.candidate }}</td><td>{{ row.change }}</td></tr>{% endfor %}</table>{% endif %}{% endif %}
<h2>Examples</h2>{% for row in rows %}<details><summary>{{ row.status }} · {{ row.question }}</summary><p>Example {{ row.example_id }} · Run {{ row.run_id }} · Split {{ row.split }}</p><h3>Candidate SQL</h3><pre>{{ row.output.sql | default('Unavailable') }}</pre><h3>Reference SQL</h3><pre>{{ row.reference_sql }}</pre><p>{{ row.evaluation.explanation }}</p><p>Category: {{ row.evaluation.failure_category }} · Suggested check: {{ row.evaluation.suggested_check }}</p><p>Trace ID: {{ row.output.trace_id | default('Not provided', true) }} · Latency: {{ row.output.latency_ms | default('Unavailable') }} ms ({{ row.output.latency_origin }})</p></details>{% endfor %}
<details><summary>Configuration and provenance</summary><pre>{{ summary | tojson(indent=2) }}</pre></details></html>
